{
  "name": "eneide",
  "version": "3.3.3",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt build",
    "dev": "nuxt dev",
    "design:compare": "node ./scripts/design-compare.mjs",
    "dev:clean": "rm -rf .nuxt .output node_modules/.vite && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "sdk:build": "bun run --cwd packages/sdk build",
    "cli:build": "bun run --cwd packages/cli build",
    "packages:build": "bun run sdk:build && bun run cli:build",
    "bump:version": "node ./scripts/bump-version.mjs patch",
    "bump:fix": "node ./scripts/bump-version.mjs fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "bump:minor": "node ./scripts/bump-version.mjs minor",
    "bump:major": "node ./scripts/bump-version.mjs major",
    "version": "node ./scripts/tag-version.mjs"
  },
