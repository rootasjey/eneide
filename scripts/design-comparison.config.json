{
  "home": {
    "description": "Selected Works section compared with the Core homepage.",
    "localUrl": "http://localhost:3000/fr/",
    "referenceUrl": "https://core.primedirection.org/",
    "viewport": {
      "width": 1496,
      "height": 850
    },
    "elements": [
      {
        "name": "Selected Works heading",
        "local": ".home-project-heading h2",
        "reference": "section.section-works h2"
      },
      {
        "name": "Project thumbnail",
        "local": ".site-home-project-image img",
        "reference": "section.section-works article img"
      },
      {
        "name": "Project tag",
        "local": ".site-home-project-meta > span:first-child",
        "reference": "section.section-works article .card-meta a[href*='/tag/']"
      }
    ],
    "hoverStates": [
      {
        "name": "Project thumbnail hover",
        "local": ".site-home-project-card:first-of-type .site-home-project-image img",
        "reference": "section.section-works article:first-of-type .image img"
      },
      {
        "name": "Project tag hover",
        "local": ".site-home-project-card:first-of-type .site-home-project-meta > span:first-child",
        "reference": "section.section-works article:first-of-type .card-meta a[href*='/tag/']"
      }
    ]
  },
  "posts": {
    "description": "Public posts archive compared with the Core journal.",
    "localUrl": "http://localhost:3000/posts",
    "referenceUrl": "https://core.primedirection.org/blog/",
    "viewport": {
      "width": 1496,
      "height": 850
    },
    "elements": [
      {
        "name": "Article title",
        "local": ".site-public-post-title",
        "reference": ".card h2, .card h3"
      },
      {
        "name": "Publication date",
        "local": ".site-public-post-meta time",
        "reference": ".card .card-meta time"
      },
      {
        "name": "Tag",
        "local": ".site-public-post-tag",
        "reference": "a[href='/tag/creative/']"
      }
    ],
    "hoverStates": [
      {
        "name": "Tag hover",
        "local": ".site-public-post-tag",
        "reference": "a[href='/tag/creative/']"
      }
    ]
  },
  "about": {
    "description": "About page structure and typography compared with Core's Now page.",
    "localUrl": "http://localhost:3000/about",
    "referenceUrl": "https://core.primedirection.org/now/",
    "viewport": {
      "width": 1496,
      "height": 850
    },
    "elements": [
      {
        "name": "Page heading",
        "local": ".site-about h1",
        "reference": "article.page > .post-header > h1"
      },
      {
        "name": "Page introduction",
        "local": ".site-about-header > p",
        "reference": "article.page > .post-header > p"
      },
      {
        "name": "Cover image",
        "local": ".site-about-cover img",
        "reference": "article.page .post-header .feature-media-image img"
      },
      {
        "name": "Content section heading",
        "local": ".site-about h2",
        "reference": "article.page .content-wrapper .content h2"
      },
      {
        "name": "Body paragraph",
        "local": ".site-about-introduction > p:first-child",
        "reference": "article.page .content-wrapper .content p"
      }
    ]
  }
}
